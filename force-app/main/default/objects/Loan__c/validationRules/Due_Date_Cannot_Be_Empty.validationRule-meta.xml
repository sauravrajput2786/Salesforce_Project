<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Due_Date_Cannot_Be_Empty</fullName>
    <active>true</active>
    <errorConditionFormula>AND ( NOT (ISBLANK( Member__c )),
      ISBLANK( Due_Date__c ) )</errorConditionFormula>
    <errorDisplayField>Due_Date__c</errorDisplayField>
    <errorMessage>Due Date Cannot Be Empty If Member is allocated</errorMessage>
</ValidationRule>
