<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Required_For_Technology</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Industry, &quot;Technology&quot;),
    ISBLANK(Phone)
)</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone is required for technology accounts .</errorMessage>
</ValidationRule>
