<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Website_Required_For_Enterprise</fullName>
    <active>true</active>
    <errorConditionFormula>AND ( ISPICKVal(Type ,&quot;Enterprise&quot;),
       ISBLANK(  Website ) 
     )</errorConditionFormula>
    <errorDisplayField>Website</errorDisplayField>
    <errorMessage>Website is required for Enterprise Accounts.</errorMessage>
</ValidationRule>
