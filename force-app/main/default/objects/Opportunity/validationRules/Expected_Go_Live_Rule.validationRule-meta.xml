<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expected_Go_Live_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>AND (
       ISPICKVAL(StageName, &quot;Closed Won&quot;),
       ISBLANK(Expected_Go_Live_Date__c) 
     )</errorConditionFormula>
    <errorDisplayField>Expected_Go_Live_Date__c</errorDisplayField>
    <errorMessage>Expected Go-Live Date is required when Opportunity is Closed Won.</errorMessage>
</ValidationRule>
