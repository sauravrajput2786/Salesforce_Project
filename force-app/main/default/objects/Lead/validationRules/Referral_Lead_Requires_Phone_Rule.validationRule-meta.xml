<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Referral_Lead_Requires_Phone_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
 ISPICKVAL(LeadSource , &quot;Referral&quot;),
 ISBLANK( Phone ) 
 )</errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone is required when Lead Source is Referral.</errorMessage>
</ValidationRule>
