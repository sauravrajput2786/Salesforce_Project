<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Region Based Assignment</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>North_America_Sales_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Lead_Region__c</field>
                <operation>equals</operation>
                <value>North America</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Europe_Sales_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Lead_Region__c</field>
                <operation>equals</operation>
                <value>Europe</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Asia_Sales_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Lead_Region__c</field>
                <operation>equals</operation>
                <value>Asia</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>North_America_Sales_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <formula>true</formula>
        </ruleEntry>
    </assignmentRule>
    <assignmentRule>
        <fullName>Standard</fullName>
        <active>false</active>
        <ruleEntry>
            <assignedTo>epic.f5a5ab44d330@orgfarm.salesforce.com</assignedTo>
            <assignedToType>User</assignedToType>
            <criteriaItems>
                <field>Lead.Country</field>
                <operation>equals</operation>
                <value>US,USA,United States,United States of America</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>epic.f5a5ab44d330@orgfarm.salesforce.com</assignedTo>
            <assignedToType>User</assignedToType>
            <criteriaItems>
                <field>Lead.Country</field>
                <operation>notEqual</operation>
                <value>US,USA,United States,United States of America</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
    <assignmentRule>
        <fullName>Website Lead Assignment</fullName>
        <active>false</active>
        <ruleEntry>
            <assignedTo>Sales_Team</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>Web</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
