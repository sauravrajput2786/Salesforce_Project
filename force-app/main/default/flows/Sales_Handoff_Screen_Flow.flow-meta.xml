        <locationX>182</locationX>
        <locationY>1298</locationY>
        <defaultConnector>
            <targetReference>Create_Sales_Handoff</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No (Create New)</defaultConnectorLabel>
        <rules>
            <name>Outcome_Handoff_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Sales_Handoff.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sales_Handoff</targetReference>
            </connector>
            <label>Yes (Update Existing)</label>
        </rules>
