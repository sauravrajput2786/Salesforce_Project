<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Cases_Collection</name>
        <label>Add To Cases Collection</label>
        <locationX>90</locationX>
        <locationY>1200</locationY>
        <assignmentItems>
            <assignToReference>varCol_CasesToClose</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varSingle_Case</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Open_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_To_Chatter_Collection</name>
        <label>Add To Chatter Collection</label>
        <locationX>270</locationX>
        <locationY>1200</locationY>
        <assignmentItems>
            <assignToReference>varCol_FeedItemsToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varSingle_FeedItem</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Open_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Case_Resolution_Data</name>
        <label>Assign Case Resolution Data</label>
        <locationX>90</locationX>
        <locationY>1080</locationY>
        <assignmentItems>
            <assignToReference>varSingle_Case.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Open_Cases.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingle_Case.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingle_Case.Resolution_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Bug Fix / Hotfix Patch</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingle_Case.Resolution_Summary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_ResolutionSummary</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingle_Case.Fix_Version__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Fixed_In_Version__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Cases_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Collect_Case_Id</name>
        <label>Collect Case Id</label>
        <locationX>138</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>varCol_CaseIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Junctions.Case__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Junctions</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_High_Touch_Chatter</name>
        <label>Assign High-Touch Chatter Alert</label>
        <locationX>270</locationX>
        <locationY>1080</locationY>
        <assignmentItems>
            <assignToReference>varSingle_FeedItem.ParentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Open_Cases.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingle_FeedItem.Body</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_HighTouchChatterNotice</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Chatter_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_If_Cases_To_Update</name>
        <label>Check If Cases To Update</label>
        <locationX>50</locationX>
        <locationY>1340</locationY>
        <defaultConnector>
            <targetReference>Check_If_Chatter_To_Post</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Zero Cases To Update</defaultConnectorLabel>
        <rules>
            <name>Has_Cases_To_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCol_CasesToClose</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bulk_Update_Linked_Cases</targetReference>
            </connector>
            <label>Has Cases To Update</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Chatter_To_Post</name>
        <label>Check If Chatter To Post</label>
        <locationX>50</locationX>
        <locationY>1580</locationY>
        <defaultConnectorLabel>Zero Chatter To Post</defaultConnectorLabel>
        <rules>
            <name>Has_Chatter_To_Post</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCol_FeedItemsToCreate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bulk_Create_Chatter_Alerts</targetReference>
            </connector>
            <label>Has Chatter To Post</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Junctions_Exist</name>
        <label>Check If Junctions Exist</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No Linked Cases</defaultConnectorLabel>
        <rules>
            <name>Has_Linked_Cases</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Linked_Case_Junctions</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Junctions</targetReference>
            </connector>
            <label>Has Linked Cases</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Open_Cases_Found</name>
        <label>Check If Open Cases Found</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <defaultConnectorLabel>Zero Open Cases Found</defaultConnectorLabel>
        <rules>
            <name>Has_Open_Cases</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Cases_Bulk</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Open_Cases</targetReference>
            </connector>
            <label>Has Open Cases</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Is_High_Touch</name>
        <label>Is High-Touch Case?</label>
        <locationX>180</locationX>
        <locationY>960</locationY>
        <defaultConnector>
            <targetReference>Assign_Case_Resolution_Data</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Standard Case (Auto-Close)</defaultConnectorLabel>
        <rules>
            <name>Rule_Is_High_Touch</name>
            <conditionLogic>(1 OR 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Open_Cases.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Critical</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Open_Cases.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Escalated</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Open_Cases.Escalation_Reason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>SLA Breach Risk</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Open_Cases.Escalation_Reason__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_High_Touch_Chatter</targetReference>
            </connector>
            <label>High-Touch (Critical or Escalated)</label>
        </rules>
    </decisions>
    <description>Known Issue Mass-Resolution Engine. When a Known Issue is marked Resolved or Closed, bulkifies linked open cases. Standard cases are auto-closed with resolution details; High-Touch cases (Critical priority or Escalated status) remain open for the assigned agent with an automated manual verification Chatter alert.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_FaultErrorMessage</name>
        <dataType>String</dataType>
        <expression>&quot;⚠️ Mass resolution failed on linked cases for Known Issue &quot; + {!$Record.Name} + &quot;: &quot; + {!$Flow.FaultMessage}</expression>
    </formulas>
    <formulas>
        <name>fx_HighTouchChatterNotice</name>
        <dataType>String</dataType>
        <expression>&quot;⚠️ [Manual Verification Required] Known Issue &quot; + {!$Record.Name} + &quot; (&quot; + {!$Record.Issue_Title__c} + &quot;) has been marked &quot; + TEXT({!$Record.Status__c}) + &quot;. Verified fix deployed in release: &quot; + BLANKVALUE({!$Record.Fixed_In_Version__c}, &quot;Latest Patch&quot;) + &quot;. Because this case is marked Critical / Escalated, it was NOT auto-closed. Please verify with the customer and close manually.&quot;</expression>
    </formulas>
    <formulas>
        <name>fx_ResolutionSummary</name>
        <dataType>String</dataType>
        <expression>&quot;Resolved via Known Issue &quot; + {!$Record.Name} + &quot; (&quot; + {!$Record.Issue_Title__c} + &quot;). Verified fix deployed in release: &quot; + BLANKVALUE({!$Record.Fixed_In_Version__c}, &quot;Latest Patch&quot;)</expression>
    </formulas>
    <interviewLabel>Known Issue Mass Resolver {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Known Issue Mass Resolver</label>
    <loops>
        <name>Loop_Junctions</name>
        <label>Loop Junctions</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>Get_Linked_Case_Junctions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Collect_Case_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Open_Cases_Bulk</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Open_Cases</name>
        <label>Loop Open Cases</label>
        <locationX>50</locationX>
        <locationY>840</locationY>
        <collectionReference>Get_Open_Cases_Bulk</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Is_High_Touch</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_If_Cases_To_Update</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Bulk_Create_Chatter_Alerts</name>
        <label>Bulk Create Chatter Alerts</label>
        <locationX>50</locationX>
        <locationY>1700</locationY>
        <faultConnector>
            <targetReference>Create_Fault_FeedItem</targetReference>
        </faultConnector>
        <inputReference>varCol_FeedItemsToCreate</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_Fault_FeedItem</name>
        <label>Post Fault Chatter on Known Issue</label>
        <locationX>314</locationX>
        <locationY>1580</locationY>
        <inputAssignments>
            <field>Body</field>
            <value>
                <elementReference>fx_FaultErrorMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>FeedItem</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Linked_Case_Junctions</name>
        <label>Get Linked Case Junctions</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Junctions_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Known_Issue__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case_Known_Issue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Cases_Bulk</name>
        <label>Get Open Cases Bulk</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Open_Cases_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>varCol_CaseIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Bulk_Update_Linked_Cases</name>
        <label>Bulk Update Linked Cases</label>
        <locationX>50</locationX>
        <locationY>1460</locationY>
        <connector>
            <targetReference>Check_If_Chatter_To_Post</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Fault_FeedItem</targetReference>
        </faultConnector>
        <inputReference>varCol_CasesToClose</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Linked_Case_Junctions</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Resolved</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <object>Known_Issue__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varCol_CaseIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varCol_CasesToClose</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>varCol_FeedItemsToCreate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FeedItem</objectType>
    </variables>
    <variables>
        <name>varSingle_Case</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>varSingle_FeedItem</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>FeedItem</objectType>
    </variables>
</Flow>