    <description>Record-Triggered Flow on Opportunity (After Save) that runs when Stage changes to Closed Won. Handles duplicate checking, creates Customer Onboarding, Sales Handoff, Onboarding Task, sends Notification, and includes Fault Paths.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_AssignedImplementationManagerId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Implementation_Manager_User.Id}), {!$Record.OwnerId}, {!Get_Implementation_Manager_User.Id})</expression>
    </formulas>
    <formulas>
        <name>formula_CalculatedCustomerTier</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Account.Customer__c}) = &quot;Gold&quot;, &quot;Gold&quot;,
   IF({!$Record.Amount} &gt;= 50000, &quot;Gold&quot;,
      IF(TEXT({!$Record.Account.Customer__c}) = &quot;Silver&quot;, &quot;Silver&quot;,
         IF({!$Record.Amount} &gt;= 25000, &quot;Silver&quot;, &quot;Platinum&quot;)
      )
   )
)</expression>
    </formulas>
    <formulas>
        <name>formula_EntitlementEndDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 365</expression>
    </formulas>
    <formulas>
        <name>formula_EntitlementName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account.Name} &amp; &quot; &quot; &amp; {!formula_CalculatedCustomerTier} &amp; &quot; Enterprise SLA&quot;</expression>
    </formulas>
    <formulas>
        <name>formula_ErrorTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;ERROR: Opportunity Closed Won Flow Failed for &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>formula_NotificationEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Implementation_Manager_User.Email}), {!$Record.Owner.Email}, {!Get_Implementation_Manager_User.Email})</expression>
    </formulas>
    <formulas>
        <name>formula_NotificationSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Customer Onboarding Kickoff: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>formula_SlaProcessName</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.Amount} &gt;= 50000, &quot;Gold_Tier_SLA_Process&quot;, IF({!$Record.Amount} &gt;= 25000, &quot;Silver_Tier_SLA_Process&quot;, &quot;Platinum_Tier_SLA_Process&quot;))</expression>
    </formulas>
    <formulas>
        <name>formula_TargetCompletionDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 30</expression>
    </formulas>
    <formulas>
        <name>formula_TaskDueDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 3</expression>
    </formulas>
    <interviewLabel>Opportunity Closed Won Flow {!$Flow.CurrentDateTime}</interviewLabel>
