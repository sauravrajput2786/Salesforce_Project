<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_To_Collection</name>
        <label>Add To Collection</label>
        <locationX>138</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>varCol_SiblingsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varSingle_SiblingToUpdate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Sibling_Cases</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Sibling_Resolution_Values</name>
        <label>Assign Sibling Resolution Values</label>
        <locationX>138</locationX>
        <locationY>480</locationY>
        <assignmentItems>
            <assignToReference>varSingle_SiblingToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Sibling_Cases.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingle_SiblingToUpdate.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingle_SiblingToUpdate.Resolution_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Resolution_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varSingle_SiblingToUpdate.Resolution_Summary__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_SiblingResolutionSummary</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_To_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_If_Siblings_Found</name>
        <label>Check If Siblings Found</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No Sibling Cases</defaultConnectorLabel>
        <rules>
            <name>Has_Open_Siblings</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Sibling_Cases</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Sibling_Cases</targetReference>
            </connector>
            <label>Has Open Siblings</label>
        </rules>
    </decisions>
    <description>Enterprise Cascading Resolution Engine. When a Root Primary Case is marked Closed, automatically queries all open sibling follow-up cases (linked via Related_Open_Case__c), dynamically copies the resolution details, and closes them in a single bulk-safe DML update with recursion guard.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_SiblingResolutionSummary</name>
        <dataType>String</dataType>
        <expression>&quot;Resolved via Root Case #&quot; + {!$Record.CaseNumber} + &quot;: &quot; + BLANKVALUE({!$Record.Resolution_Summary__c}, &quot;Resolved by engineering.&quot;)</expression>
    </formulas>
    <interviewLabel>Case Cascading Resolution Engine {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Cascading Resolution Engine</label>
    <loops>
        <name>Loop_Sibling_Cases</name>
        <label>Loop Sibling Cases</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <collectionReference>Get_Open_Sibling_Cases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Sibling_Resolution_Values</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Bulk_Update_Sibling_Cases</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Sibling_Cases</name>
        <label>Get Open Sibling Cases</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Siblings_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Related_Open_Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Customer_Product__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Customer_Product__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Bulk_Update_Sibling_Cases</name>
        <label>Bulk Update Sibling Cases</label>
        <locationX>50</locationX>
        <locationY>840</locationY>
        <inputReference>varCol_SiblingsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Open_Sibling_Cases</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Related_Open_Case__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varCol_SiblingsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>varSingle_SiblingToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
</Flow>
