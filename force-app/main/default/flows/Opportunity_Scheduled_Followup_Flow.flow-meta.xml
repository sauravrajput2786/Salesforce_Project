<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Owner_Notification_Email</name>
        <label>Send Notification Email to Owner</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Owner.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>textTemplate_EmailBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>formula_EmailSubject</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_Is_Deal_Stalled</name>
        <label>Is Deal Stalled (No Activity for 7+ Days)?</label>
        <locationX>374</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Recently Active (Skip)</defaultConnectorLabel>
        <rules>
            <name>Outcome_Deal_Is_Stalled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_IsStalled</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Open_Task</targetReference>
            </connector>
            <label>Stalled (7+ Days Inactive)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Open_Task_Exists</name>
        <label>Does Open Follow-Up Task Already Exist?</label>
        <locationX>242</locationX>
        <locationY>446</locationY>
        <defaultConnectorLabel>Open Task Exists (Prevent Duplicate)</defaultConnectorLabel>
        <rules>
            <name>Outcome_No_Open_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Open_Task.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Followup_Task</targetReference>
            </connector>
            <label>No Open Task (Proceed)</label>
        </rules>
    </decisions>
    <description>Daily Scheduled Flow on open Opportunities that identifies stalled deals with no activity for 7+ days, prevents duplicate follow-up tasks, creates a Task for the Opportunity Owner, and sends an email notification.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_EmailSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Action Required: Stalled Deal Follow-Up - &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>formula_ErrorTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;ERROR: Opportunity Scheduled Follow-Up Flow Failed for &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>formula_IsStalled</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISBLANK({!$Record.LastActivityDate}), DATEVALUE({!$Record.CreatedDate}) &lt;= {!formula_SevenDaysAgo}, {!$Record.LastActivityDate} &lt;= {!formula_SevenDaysAgo})</expression>
    </formulas>
    <formulas>
        <name>formula_SevenDaysAgo</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 7</expression>
    </formulas>
    <formulas>
        <name>formula_TaskDueDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 2</expression>
    </formulas>
    <formulas>
        <name>formula_TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Follow up on stalled deal: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <interviewLabel>Opportunity Scheduled Follow-Up Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Scheduled Follow-Up Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
