    <recordCreates>
        <name>Create_Followup_Task</name>
        <label>Create Follow-Up Task</label>
        <locationX>176</locationX>
        <locationY>548</locationY>
        <connector>
            <targetReference>Send_Owner_Notification_Email</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Create_Error_Log_Task</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>ActivityDate</field>
