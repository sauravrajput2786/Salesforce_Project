<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_Is_Uncontacted_3_Days</name>
        <label>Is Lead Uncontacted for 3+ Days?</label>
        <locationX>374</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Recently Active (Skip)</defaultConnectorLabel>
        <rules>
            <name>Outcome_Uncontacted_3_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_IsUncontactedThreeDays</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Open_Reminder_Task</targetReference>
            </connector>
            <label>Uncontacted 3+ Days</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Open_Task_Exists</name>
        <label>Does Open Reminder Task Already Exist?</label>
        <locationX>242</locationX>
        <locationY>446</locationY>
        <defaultConnectorLabel>Open Task Exists (Prevent Duplicate)</defaultConnectorLabel>
        <rules>
            <name>Outcome_No_Open_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Open_Reminder_Task.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Reminder_Task</targetReference>
            </connector>
            <label>No Open Task (Proceed)</label>
        </rules>
    </decisions>
    <description>Daily Scheduled Flow on Leads: Identifies unconverted leads that have not been contacted for 3 or more days, prevents duplicate tasks, and creates an urgent reminder task for the Lead Owner.</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_DueDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 1</expression>
    </formulas>
    <formulas>
        <name>formula_IsUncontactedThreeDays</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISBLANK({!$Record.LastActivityDate}), DATEVALUE({!$Record.CreatedDate}) &lt;= {!formula_ThreeDaysAgo}, {!$Record.LastActivityDate} &lt;= {!formula_ThreeDaysAgo})</expression>
    </formulas>
    <formulas>
        <name>formula_TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Reminder: Uncontacted Lead - &quot; &amp; IF(ISBLANK({!$Record.FirstName}), &quot;&quot;, {!$Record.FirstName} &amp; &quot; &quot;) &amp; {!$Record.LastName}</expression>
    </formulas>
    <formulas>
        <name>formula_ThreeDaysAgo</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 3</expression>
    </formulas>
    <interviewLabel>Lead - Uncontacted 3-Day Reminder Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - Uncontacted 3-Day Reminder Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Reminder_Task</name>
        <label>Create Reminder Task</label>
        <locationX>110</locationX>
        <locationY>554</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>formula_DueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>This lead has been in Open status for 3 or more days without any logged activity. Please reach out to the customer immediately to qualify and keep the deal warm.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>formula_TaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Open_Reminder_Task</name>
        <label>Check for Existing Open Reminder Task</label>
        <locationX>242</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Open_Task_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhoId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Priority</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Is_Uncontacted_3_Days</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Open - Not Contacted</stringValue>
            </value>
        </filters>
        <object>Lead</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-10-20</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
