    <description>Pillar 3: AI Defect &amp; Known Issue Linker. On Case create/update, dynamically matches active Known Issues based on keywords (504, Timeout, Outage) in Subject or Description, creates Case_Known_Issue__c junction record, posts the workaround to Chatter feed, and sends an automated workaround email to the customer contact.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_CustomerEmail</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.Contact.Email}, {!$Record.SuppliedEmail})</expression>
    </formulas>
    <formulas>
        <name>fx_EmailSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Verified Workaround Available: [Case #&quot; + {!$Record.CaseNumber} + &quot;] &quot; + {!Loop_Known_Issues.Issue_Title__c}</expression>
    </formulas>
    <formulas>
        <name>fx_Is504TimeoutMatch</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  AND(
    OR(CONTAINS(LOWER({!$Record.Subject}), &quot;504&quot;), CONTAINS(LOWER(BLANKVALUE({!$Record.Description}, &quot;&quot;)), &quot;504&quot;)),
    OR(CONTAINS(LOWER({!$Record.Subject}), &quot;timeout&quot;), CONTAINS(LOWER(BLANKVALUE({!$Record.Description}, &quot;&quot;)), &quot;timeout&quot;))
  ),
  OR(
    CONTAINS(LOWER({!$Record.Subject}), &quot;outage&quot;),
    CONTAINS(LOWER(BLANKVALUE({!$Record.Description}, &quot;&quot;)), &quot;outage&quot;)
  )
)</expression>
    </formulas>
    <interviewLabel>Case Known Issue AutoLinker {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Known Issue AutoLinker</label>
    <loops>
        <name>Loop_Known_Issues</name>
        <label>Loop Known Issues</label>
        <locationX>264</locationX>
        <locationY>240</locationY>
        <collectionReference>Get_Active_Known_Issues</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Decision_Is_Technical_Match</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
