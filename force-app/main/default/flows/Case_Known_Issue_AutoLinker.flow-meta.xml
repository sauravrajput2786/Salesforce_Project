            </value>
        </inputAssignments>
        <object>Case_Known_Issue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Post_Workaround_Chatter</name>
        <label>Post Workaround Chatter</label>
        <locationX>220</locationX>
        <locationY>840</locationY>
        <connector>
            <targetReference>Decision_Has_Email_And_Workaround</targetReference>
        </connector>
        <inputAssignments>
            <field>Body</field>
            <value>
                <elementReference>tt_ChatterBody</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentId</field>
