    </recordLookups>
    <recordLookups>
        <name>Get_Active_Known_Issues</name>
        <label>Get Active Known Issues</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Known_Issues_Found</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Investigating</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Known_Issue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Active_Known_Issues</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.Subject})),
  NOT({!$Record.IsClosed}),
  TEXT({!$Record.Type}) != &apos;Other&apos;
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>tt_ChatterBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>[AI Defect Linker] Case automatically linked to Known Issue {!Loop_Known_Issues.Name} ({!Loop_Known_Issues.Issue_Title__c}).

Verified Engineering Workaround:
{!Loop_Known_Issues.Workaround__c}</text>
    </textTemplates>
    <textTemplates>
        <name>tt_CustomerEmailBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Dear Customer,

We have received your support request regarding: {!$Record.Subject} (Case #{!$Record.CaseNumber}).

Our automated diagnostics system has detected that your issue is linked to a known active platform defect ({!Loop_Known_Issues.Name}: {!Loop_Known_Issues.Issue_Title__c}).

Our engineering team has verified an immediate workaround to unblock your operations:
--------------------------------------------------
WORKAROUND / SOLUTION:
{!Loop_Known_Issues.Workaround__c}
--------------------------------------------------

Our engineering team is actively rolling out a permanent patch. We will notify you automatically as soon as the patch is fully deployed.

Best regards,
TechNova Intelligent Cloud Support Team</text>
    </textTemplates>
</Flow>
