<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Gold_Entitlement</name>
        <label>Assign Gold Entitlement to Case</label>
        <locationX>176</locationX>
        <locationY>840</locationY>
        <assignmentItems>
            <assignToReference>$Record.EntitlementId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_GoldEntitlement.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Platinum_Entitlement</name>
        <label>Assign Platinum Entitlement to Case</label>
        <locationX>616</locationX>
        <locationY>840</locationY>
        <assignmentItems>
            <assignToReference>$Record.EntitlementId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_PlatinumEntitlement.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Silver_Entitlement</name>
        <label>Assign Silver Entitlement to Case</label>
        <locationX>396</locationX>
        <locationY>840</locationY>
        <assignmentItems>
            <assignToReference>$Record.EntitlementId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_SilverEntitlement.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Customer_Tier</name>
        <label>Check Customer Tier</label>
        <locationX>396</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Get_Silver_Entitlement</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Silver Tier</defaultConnectorLabel>
        <rules>
            <name>Is_Gold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Account.Customer__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Gold</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Gold_Entitlement</targetReference>
            </connector>
            <label>Gold Tier (Rank 1)</label>
        </rules>
        <rules>
            <name>Is_Silver</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Account.Customer__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Silver</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Silver_Entitlement</targetReference>
            </connector>
            <label>Silver Tier (Rank 2)</label>
        </rules>
        <rules>
            <name>Is_Platinum</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Account.Customer__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Platinum</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Platinum_Entitlement</targetReference>
            </connector>
            <label>Platinum Tier (Rank 3)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Gold_Entitlement_Found</name>
        <label>Gold Entitlement Found?</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <defaultConnectorLabel>No Gold Entitlement</defaultConnectorLabel>
        <rules>
            <name>Gold_Ent_Found_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_GoldEntitlement</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Gold_Entitlement</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Active_Product</name>
        <label>Has Active Customer Product?</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <defaultConnectorLabel>No Active Product (Skip)</defaultConnectorLabel>
        <rules>
            <name>Active_Product_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_ActiveProduct</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Customer_Tier</targetReference>
            </connector>
            <label>Yes - Active Product Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Platinum_Entitlement_Found</name>
        <label>Platinum Entitlement Found?</label>
        <locationX>616</locationX>
        <locationY>720</locationY>
        <defaultConnectorLabel>No Platinum Entitlement</defaultConnectorLabel>
        <rules>
            <name>Platinum_Ent_Found_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_PlatinumEntitlement</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Platinum_Entitlement</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Silver_Entitlement_Found</name>
        <label>Silver Entitlement Found?</label>
        <locationX>396</locationX>
        <locationY>720</locationY>
        <defaultConnectorLabel>No Silver Entitlement</defaultConnectorLabel>
        <rules>
            <name>Silver_Ent_Found_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_SilverEntitlement</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Silver_Entitlement</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Pillar 1 - Smart Gatekeeper: On Case creation, checks Active Customer_Product__c, inspects Account Customer Tier (Gold = 60m SLA, Silver = 240m SLA, Platinum = 480m SLA), and auto-populates Case.EntitlementId.</description>
    <environments>Default</environments>
    <interviewLabel>Case Entitlement Gatekeeper {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Entitlement Gatekeeper</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Check_Active_Product</name>
        <label>Check Active Customer Product</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Active_Product</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>Renewal_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <object>Customer_Product__c</object>
        <outputReference>var_ActiveProduct</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status__c</queriedFields>
        <queriedFields>Renewal_Date__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Account_Tier</name>
        <label>Get Account Tier</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Active_Product</targetReference>
        </connector>
        <filterLogic>1</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>var_Account</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Customer__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Gold_Entitlement</name>
        <label>Get Gold Entitlement Record</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Gold_Entitlement_Found</targetReference>
        </connector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Gold</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <object>Entitlement</object>
        <outputReference>var_GoldEntitlement</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Platinum_Entitlement</name>
        <label>Get Platinum Entitlement Record</label>
        <locationX>616</locationX>
        <locationY>600</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Platinum_Entitlement_Found</targetReference>
        </connector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Platinum</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <object>Entitlement</object>
        <outputReference>var_PlatinumEntitlement</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Silver_Entitlement</name>
        <label>Get Silver Entitlement Record</label>
        <locationX>396</locationX>
        <locationY>600</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Silver_Entitlement_Found</targetReference>
        </connector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Silver</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <object>Entitlement</object>
        <outputReference>var_SilverEntitlement</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Account_Tier</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.AccountId})),
  ISBLANK({!$Record.EntitlementId})
)</filterFormula>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_Account</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>var_ActiveProduct</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Customer_Product__c</objectType>
    </variables>
    <variables>
        <name>var_GoldEntitlement</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Entitlement</objectType>
    </variables>
    <variables>
        <name>var_PlatinumEntitlement</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Entitlement</objectType>
    </variables>
    <variables>
        <name>var_SilverEntitlement</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Entitlement</objectType>
    </variables>
</Flow>
